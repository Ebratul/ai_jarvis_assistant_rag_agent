# NONO RAG agent — copy to .env
RAG_HOST=0.0.0.0
RAG_PORT=8100
# Optional shared secret; the backend must send the same value in X-Nono-Key
RAG_API_KEY=
# Where the brain lives. Keep this folder backed up — it is your 20-year memory.
NONO_DATA_DIR=./data
# hash (default, multilingual, zero download) | fastembed | huggingface
EMBEDDING_BACKEND=hash
FASTEMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
HF_TOKEN=
HF_EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Daily snapshot backups kept in data/backups
BACKUP_KEEP=30
CORS_ORIGINS=*
